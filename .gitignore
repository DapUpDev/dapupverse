# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/
/screenshots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# machine-specific Claude Code launch config
.claude/launch.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (a tracked .env.example is explicitly allowed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (api/)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# terraform (infra/) — state and provider binaries never belong in git
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.auto.tfvars.example
.terraform.lock.hcl.bak

# WeWeb export (read-only reference material — must never be committed)
DapUp-main*.zip
/weweb-export/
/DapUp-main/
