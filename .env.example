# DapUp environment variables (names and safe paths only — never put real
# keys in this file). Copy the Clerk keys into an untracked .env.local for
# local development (`clerk init` writes them automatically), and into the
# Vercel Preview/Production environment settings for deploys.

# Clerk (required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk component routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Post-auth fallback destinations are set as component props in
# src/app/sign-in and src/app/sign-up (sign-in -> /app,
# sign-up -> /app/profile?setup=onboarding).
