# DapUp environment variables (names and safe paths only — never put real
# keys in this file). Copy the Clerk keys into an untracked .env.local for
# local development (`clerk init` writes them automatically), and into the
# Vercel Preview/Production environment settings for deploys.

# Clerk (required) — the ONLY variables a deployment needs.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Component routing (NEXT_PUBLIC_CLERK_SIGN_IN_URL / _SIGN_UP_URL) is baked
# into next.config.ts, and post-auth fallback destinations are component
# props in src/app/sign-in and src/app/sign-up — no extra env vars needed.

# Backend API (Stage 3 of the AWS milestone). Public, non-secret. Set in
# Vercel Production to https://api.dapup.space; locally point at a running
# uvicorn (http://localhost:8000). Not yet read by the frontend.
NEXT_PUBLIC_API_BASE_URL=https://api.dapup.space
